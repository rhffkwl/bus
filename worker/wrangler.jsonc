{
  "name": "bus-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://rhffkwl.github.io" },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
